<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="Sprite Layer Editor"
                      MinSize="400 300">

    <BoxContainer Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True">

        <!-- left: layer selector -->
        <ItemList Name="LayerList"
                  MinWidth="150"
                  VerticalExpand="True" />

        <!-- right: preview and color sliders -->
        <BoxContainer Orientation="Vertical"
                      HorizontalExpand="True"
                      VerticalExpand="True"
                      Margin="4 0 0 0">

            <BoxContainer Orientation="Horizontal"
                          HorizontalAlignment="Center"
                          Margin="0 0 0 8">

                <SpriteView Name="Preview"
                            Scale="4 4"
                            Margin="0 0 0 8" />

                <SpriteView Name="ClothingVisualsPreview"
                            Scale="4 4"
                            Visible="False"
                            Margin="0 0 0 8" />

            </BoxContainer>

            <ColorSelectorSliders Name="ColorSliders"
                                  HorizontalExpand="True"
                                  Margin="2 0 2 10"
                                  Visible="False"
                                  IsAlphaVisible="False"
                                  MinWidth="500"/>

            <BoxContainer Orientation="Horizontal"
                          Margin="5 5">
                <Button Name="PaintButton" Text="Paint" HorizontalExpand="True"/>
                <Button Name="ResetButton" Text="Reset" HorizontalExpand="True"/>
            </BoxContainer>

        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
